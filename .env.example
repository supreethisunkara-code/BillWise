# LocalStack (no real AWS account needed -- these are dummy values LocalStack accepts)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

SESSIONS_TABLE=billwise-sessions
BILLS_BUCKET=billwise-bills

# Real Anthropic API key -- needed since Bedrock's free LocalStack tier
# doesn't include AI model emulation. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key